{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "intention-e2e",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-e",
        "bash",
        "-c",
        "rm -rf /tmp/cft-e2e && cd ~/projects/project-cft && CFT_DATA_DIR=/tmp/cft-e2e CFT_API_PORT=47997 CFT_ALLOWED_ORIGINS=http://localhost:4173 venv/bin/python -u tests/e2e/serve.py"
      ],
      "port": 47997
    },
    {
      "name": "dashboard-preview",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-e",
        "bash",
        "-c",
        "export PATH=~/.nvm/versions/node/v24.15.0/bin:$PATH && cd ~/projects/focus-dashboard && npm run preview -- --port 4173 --strictPort"
      ],
      "port": 4173
    },
    {
      "name": "cft-api",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-e",
        "bash",
        "-c",
        "cd ~/projects/project-cft && CFT_OPEN_DASHBOARD=0 CFT_ALLOWED_ORIGINS=http://localhost:5173 venv/bin/python run.py --dashboard"
      ],
      "port": 47113
    },
    {
      "name": "focus-dashboard",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-e",
        "bash",
        "-c",
        "export PATH=~/.nvm/versions/node/v24.15.0/bin:$PATH && cd ~/projects/focus-dashboard && npm run dev -- --mode test --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}